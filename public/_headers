# Caché larga para estáticos de nombre estable (Cloudflare Pages).
# Las fuentes y las ilustraciones de /img/ solo cambian renombrando el
# archivo (p. ej. sufijo -v2), así que pueden viajar como immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# La imagen OG se reemplaza en el mismo path: caché corta para que los
# scrapers de WhatsApp/Facebook/X vean la versión vigente.
/og-image.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800

# Evidencia visual de los learning paths (cartas y páginas del manual).
/lp/*
  Cache-Control: public, max-age=31536000, immutable
